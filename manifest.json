{
  "manifest_version": 3,
  "name": "Flow Automation",
  "version": "2.0.0",
  "description": "Advanced automation for Google Flow — bulk prompt submission, gallery management, queue system with auto-retry, and API-level submission.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "downloads",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://labs.google/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://labs.google/*"],
      "js": ["api-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://labs.google/*"],
      "js": ["utils.js", "flow-configurator.js", "content.js", "panel.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://labs.google/*"]
    }
  ]
}
